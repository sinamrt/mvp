{
  "name": "google-review-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": " next dev",
    "start": "next start",
    "build": "next build ",
    "lint": "next lint",
    "test": "jest",
    "db:generate": "npx prisma generate",
    "test:watch": "jest --watch",
    "db:status": "cat .env | grep DATABASE_URL && npx prisma migrate status",
    "db:push": "npx prisma db push && npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:local": "cp .env.local .env && echo '✅ Switched to LOCAL database'",
    "db:neon": "cp .env.neon .env && echo '✅ Switched to NEON database'",
    "test:db": "jest --testPathPattern=database",
    "test:api": "jest --testPathPattern=api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.17.1",
    "@react-google-maps/api": "^2.20.7",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/speed-insights": "^1.3.1",
    "@vitejs/plugin-rsc": "^0.5.6",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "ioredis": "^5.8.2",
    "next": "^15.4.0",
    "next-auth": "^4.24.11",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "playwright": "^1.54.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-server-dom-parcel": "^19.2.1",
    "react-server-dom-webpack": "^19.2.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^11.7.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie": "^0.6.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "babel-jest": "^29.7.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
